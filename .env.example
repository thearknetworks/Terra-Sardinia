# Public URL for canonical / OG URLs (no trailing slash)
REACT_APP_SITE_ORIGIN=https://www.your-domain.com

# Prerender (server/CI only)
SEO_SITE_ORIGIN=https://www.your-domain.com
SEO_OUT_DIR=/var/www/terra/prerender
SEO_CONCURRENCY=3
# Optional API that returns JSON slug list: ["post-one", ...]
# SEO_API_BASE=https://api.your-domain.com
# Optional: rebuild subset only — JSON array of paths
# SEO_ROUTES=["/en/blog","/en/blog/my-slug"]

# Webhook (optional, see seo/webhook-server.js)
# SEO_WEBHOOK_SECRET=long-random-string
